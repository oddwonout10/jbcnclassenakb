SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

APP_ENV=local
ESCALATION_EMAIL_TO=alerts@example.com
ESCALATION_EMAIL_FROM=alerts@example.com
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4o-mini

# Optional providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
COHERE_API_KEY=
COHERE_MODEL=command

QA_SIMILARITY_THRESHOLD=0.72
QA_MAX_CHUNKS=6
QA_VECTOR_CANDIDATES=12
QA_KEYWORD_CANDIDATES=12
QA_VECTOR_WEIGHT=0.7
QA_KEYWORD_WEIGHT=0.35
QA_RECENCY_WEIGHT=0.12
QA_RATE_LIMIT_PER_MINUTE=60
QA_ENABLE_RERANKER=true
QA_RERANKER_WEIGHT=0.35
QA_RERANKER_MODEL=BAAI/bge-reranker-base
QA_RERANKER_MAX_PASSAGES=24

SUPABASE_STORAGE_BUCKET=class-circulars

# Leave empty to disable email escalation locally
TURNSTILE_SECRET_KEY=

# Optional: increment to invalidate summary cache
SUMMARY_CACHE_VERSION=
